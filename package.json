{
  "name": "mantis-browser",
  "version": "0.1.1",
  "description": "A lean browser interface for AI agents: web pages as short numbered text.",
  "type": "module",
  "license": "MIT",
  "author": "Aadit Singal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adi-devv/mantis.git"
  },
  "homepage": "https://github.com/adi-devv/mantis#readme",
  "bugs": "https://github.com/adi-devv/mantis/issues",
  "keywords": [
    "mcp",
    "browser",
    "ai-agent",
    "playwright",
    "claude",
    "web-automation",
    "accessibility"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mantis": "dist/cli.js",
    "mantis-mcp": "dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "dev:read": "tsx src/cli.ts read",
    "bench": "npm run build && tsx bench/run.ts",
    "bench:agent": "npm run build && tsx bench/agent/run.ts",
    "bench:judge": "tsx bench/agent/judge.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.64.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.83",
    "@types/node": "^26.6.5",
    "chart.js": "^4.5.1",
    "chrome-devtools-mcp": "1.10.1",
    "js-tiktoken": "1.0.21",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
